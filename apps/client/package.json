{
  "name": "@apex/client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-libs.mjs && vite --host",
    "build": "node scripts/copy-libs.mjs && tsc -p . --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p . --noEmit",
    "build:app": "node scripts/copy-libs.mjs && tsc -p . --noEmit && vite build --mode app"
  },
  "dependencies": {
    "@apex/shared": "workspace:*",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@dimforge/rapier3d-compat": "^0.14.0",
    "n8ao": "1.9.4",
    "qrcode-generator": "1.4.4",
    "three": "^0.171.0"
  },
  "devDependencies": {
    "@types/three": "^0.171.0",
    "vite": "^6.0.5"
  }
}
