config_version=5

[application]
config/name="GridCorsa"
config/icon="res://icon.png"
config/quit_on_go_back=false
boot_splash/bg_color=Color(0.0196, 0.0196, 0.0235, 1)
boot_splash/show_image=false
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Mobile")

[autoload]

Settings="*res://scripts/game/settings.gd"
Account="*res://scripts/net/account.gd"
Packs="*res://scripts/game/track_packs.gd"

[debug]

gdscript/warnings/directory_rules={
"res://addons": 0,
"res://tests": 0
}
gdscript/warnings/untyped_declaration=2
gdscript/warnings/return_value_discarded=1

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[physics]
3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120

[rendering]

textures/vram_compression/import_etc2_astc=true
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"

[apex]

packs_url=""
